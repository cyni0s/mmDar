@article{zhou2024representations,
  title     = {Exploring Radar Data Representations in Autonomous Driving: A Comprehensive Review},
  author    = {Zhou, others},
  journal   = {arXiv preprint arXiv:2312.04861},
  year      = {2024},
  url       = {https://arxiv.org/html/2312.04861v2},
  % [TASK] Survey of radar data representations for autonomous driving
  % [METHOD] Compares: ADC signals, radar tensors (post-FFT), point clouds (post-CFAR),
  %          grid maps, micro-Doppler
  % [KEY FINDING] ADC signals "retain all information from the detections" but lack spatial
  %              coherence. Each processing stage trades information for interpretability.
  %              The representation choice fundamentally limits what the network can learn.
}

