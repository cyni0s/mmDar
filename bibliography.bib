% MAGNITUDE + PHASE AS 2-CHANNEL REAL-VALUED INPUT
% =============================================================================

@inproceedings{li2023azimuth,
  title     = {Azimuth Super-Resolution for FMCW Radar in Autonomous Driving},
  author    = {Li, others},
  booktitle = {IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  year      = {2023},
  url       = {https://openaccess.thecvf.com/content/CVPR2023/papers/Li_Azimuth_Super-Resolution_for_FMCW_Radar_in_Autonomous_Driving_CVPR_2023_paper.pdf},
  % [TASK] FMCW radar azimuth angular super-resolution
  % [METHOD] Standard deep model with complex ADC data split into real+imag as 2 channels
  % [INPUT] Complex ADC data as 2 real channels (NOT a CVNN)
  % [KEY FINDING] Complex input used for azimuth SR. Compared against magnitude-domain baselines
  %              but not same-backbone ablation. Improves radar's own angular resolution.
  % [GAP] Improves radar resolution, does NOT produce lidar-quality output. No lidar replacement goal.
}

@inproceedings{liu2023echofusion,
  title     = {Echoes Beyond Points: Unleashing the Power of Raw Radar Data in Multi-modality Fusion},
  author    = {Liu, Yang and others},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  year      = {2023},
  url       = {https://arxiv.org/abs/2307.16532},
  % [TASK] 3D object detection via radar+camera fusion
  % [METHOD] Radar spectrum features (pre-CFAR) fused with camera via polar-aligned attention
  % [INPUT] Complex pre-CFAR RT spectrum as magnitude+phase 2 channels
  % [KEY FINDING] Skipping CFAR preserves weak signals. MP (mag+phase) beats IQ (real+imag)
  %              in ablation: 84.92 vs 82.64 BEV AP@0.7. Approaches lidar-only performance.
  %              Argues CFAR thresholding is "suboptimal for deep fusion."
  % [GAP] Detection (bounding boxes), not point cloud generation. Radar+camera fusion, not radar-only.
}

@inproceedings{czerkawski2022input,
  title     = {On Input Formats for Radar Micro-Doppler Signature Processing by Convolutional Neural Networks},
  author    = {Czerkawski, Mikolaj and others},
  booktitle = {IET International Radar Conference (Radar)},
  year      = {2022},
  url       = {https://strathprints.strath.ac.uk/81409/},
  % [TASK] Micro-Doppler classification (gesture/activity recognition)
  % [METHOD] Standard CNN with 5-way input format comparison
  % [INPUT] Compared: magnitude-only, phase-only, mag+phase (2ch), real+imag (2ch), all-4-channel
  % [KEY FINDING] Cleanest controlled ablation found. Mag+phase (0.938) beats magnitude-only (0.920).
  %              Phase carries useful discriminative information. Polar representation > rectangular.
  % [GAP] Classification task, not point cloud generation. Different radar application entirely.
}

@inproceedings{rebut2022fftradnet,
  title     = {Raw High-Definition Radar for Multi-Task Learning},
  author    = {Rebut, Julien and others},
  booktitle = {IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  year      = {2022},
  url       = {https://openaccess.thecvf.com/content/CVPR2022/papers/Rebut_Raw_High-Definition_Radar_for_Multi-Task_Learning_CVPR_2022_paper.pdf},
  % [TASK] Multi-task: free-space segmentation + vehicle detection from radar
  % [METHOD] FFT-RadNet — encoder-decoder with radar-specific FFT layers
  % [INPUT] Complex range-Doppler spectrum, real+imag stacked as channels
  % [KEY FINDING] Raw radar data (pre-CFAR) enables multi-task learning. No phase ablation reported.
  % [GAP] Detection/segmentation tasks, not point cloud generation.
}

% =============================================================================
% RADAR ANGULAR SUPER-RESOLUTION (signal processing approach)
% =============================================================================

@article{zhang2024srspecnet,
  title     = {SR-SPECNet: Redefining Automotive Radar Imaging},
  author    = {Zhang, others},
  journal   = {arXiv preprint arXiv:2406.07399},
  year      = {2024},
  url       = {https://arxiv.org/abs/2406.07399},
  % [TASK] Radar azimuth angular super-resolution from raw antenna signals
  % [METHOD] 4-layer MLP (1M params) treating each range-Doppler bin independently (1D problem)
  % [INPUT] Raw antenna array signals (complex-valued)
  % [KEY FINDING] 1M-param MLP outperforms 31M 2D U-Net and 52M 3D U-Net. Reframes angular SR
  %              as per-range-bin DOA estimation. Weights approximate adaptive beamforming.
  % [GAP] Raw antenna signals, not image-to-image. Would need reformulation for our pipeline.
  %        But the insight that angular SR is fundamentally 1D is relevant to our 1D ablation.
}

