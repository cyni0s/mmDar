% mmDar Project Bibliography
% Papers relevant to radar-to-lidar translation, complex-valued radar processing,
% and radar point cloud generation.
%
% Tags in comments:
%   [TASK] = what the paper does
%   [METHOD] = architecture/approach
%   [INPUT] = what radar representation they use
%   [KEY FINDING] = most relevant result for our work
%   [GAP] = what they DON'T do that we're interested in

% =============================================================================
% RADAR-TO-LIDAR TRANSLATION (direct predecessors)
% =============================================================================

@inproceedings{prabhakara2023radarhd,
  title     = {High Resolution Point Clouds from mmWave Radar},
  author    = {Prabhakara, Akarsh and Jin, Tao and Das, Arnav and Bhatt, Gantavya
               and Kumari, Lilly and Soltanaghai, Elahe and Bilmes, Jeff
               and Kumar, Swarun and Rowe, Anthony},
  booktitle = {IEEE International Conference on Robotics and Automation (ICRA)},
  year      = {2023},
  pages     = {4135--4142},
  doi       = {10.1109/ICRA48891.2023.10161429},
  % [TASK] Radar-to-lidar polar image translation (256x64 -> 256x512)
  % [METHOD] Asymmetric U-Net with 41-channel stacked radar input, BCE+Dice loss
  % [INPUT] FFT magnitude only, uint8 PNG, 5% threshold, per-frame normalized
  % [KEY FINDING] Chamfer 0.36m (reported), our reproduction 0.363m, our optimized 0.295m
  % [GAP] Discards phase, quantizes to uint8, thresholds weak returns
}

@inproceedings{hunt2024radcloud,
  title     = {RadCloud: Real-Time High-Resolution Point Cloud Generation Using Low-Cost mmWave Radar},
  author    = {Hunt, Liam and others},
  booktitle = {ACM MobiCom},
  year      = {2024},
  url       = {https://arxiv.org/abs/2403.05964},
  % [TASK] Radar-to-lidar translation, optimized for UAV/UGV real-time
  % [METHOD] U-Net encoder-decoder, 2.25x fewer params than RadarHD
  % [INPUT] Range-azimuth magnitude, threshold at 45dB below max, normalized to [0,1]. Phase discarded.
  % [KEY FINDING] Real-time >15fps on Intel NUC. Chirp-based approach resilient to motion.
  % [GAP] Same as RadarHD: magnitude-only, phase discarded. Same pipeline limitation.
}

@article{radarsfd2025,
  title     = {RadarSFD: Single-Frame Diffusion with Pretrained Priors for Radar Point Clouds},
  author    = {Unknown},
  journal   = {arXiv preprint arXiv:2509.18068},
  year      = {2025},
  url       = {https://arxiv.org/abs/2509.18068},
  % [TASK] Radar-to-lidar via latent diffusion, single-frame
  % [METHOD] Frozen TAESD VAE + U-Net initialized from Marigold depth estimator.
  %          Channel-wise latent concatenation for conditioning. L1+SSIM+LPIPS loss.
  % [INPUT] BEV radar image (magnitude-only). Phase discarded.
  % [KEY FINDING] Chamfer 0.35m single-frame on RadarHD benchmark (vs RadarHD 0.44m with 41 frames).
  %              Geometric priors from depth estimation transfer well to radar-to-lidar.
  % [GAP] Still magnitude-only input. Diffusion may worsen symmetric Chamfer (see luan2024diffusion).
}

% =============================================================================
% RADAR POINT CLOUD SUPER-RESOLUTION / DENSIFICATION
% =============================================================================

@inproceedings{luan2024diffusion,
  title     = {Diffusion-Based Point Cloud Super-Resolution for mmWave Radar Data},
  author    = {Luan, Kai and Shi, others},
  booktitle = {IEEE Intelligent Transportation Systems Conference (ITSC)},
  year      = {2024},
  url       = {https://arxiv.org/abs/2404.06012},
  % [TASK] 3D radar point cloud densification via diffusion
  % [METHOD] Mean-reverting SDE diffusion with time-dependent U-Net. BEV representation.
  % [INPUT] Processed point clouds (not raw). 5-frame aggregation.
  % [KEY FINDING] CD 0.19m on VOD dataset. BUT on RadarHD dataset: CD 0.59m (worse than RadarHD 0.44m).
  %              WARNING: denser output can WORSEN symmetric Chamfer/MHD.
  % [GAP] Operates on point clouds, not raw data. Magnitude-only.
}

@article{zheng2025r2ldm,
  title     = {R2LDM: An Efficient 4D Radar Super-Resolution Framework Leveraging Diffusion Model},
  author    = {Zheng, others},
  journal   = {arXiv preprint arXiv:2503.17097},
  year      = {2025},
  url       = {https://arxiv.org/abs/2503.17097},
  % [TASK] 4D radar point cloud densification
  % [METHOD] Latent Voxel Diffusion Model + Latent Point Cloud Reconstruction module
  % [INPUT] 4D radar point clouds (not raw)
  % [KEY FINDING] 6-10x densification, U-Net backbone outperformed transformer/MLP alternatives.
  %              31.7% improvement in registration recall, 24.9% in detection accuracy.
  % [GAP] Point cloud input, not raw radar. No complex-valued processing.
}

@article{wang2025rvdiff,
  title     = {Diffusion-Based mmWave Radar Point Cloud Enhancement Driven by Range Images},
  author    = {Wang, others},
  journal   = {arXiv preprint arXiv:2503.02300},
  year      = {2025},
  url       = {https://arxiv.org/abs/2503.02300},
  % [TASK] Radar point cloud enhancement via diffusion conditioned on range images
  % [METHOD] Diffusion conditioned on multi-channel radar range images (64x64x16)
  % [INPUT] Range image projection (not raw I/Q)
  % [KEY FINDING] Range image representation outperforms BEV by 10-15% in ablations.
  %              Argues range images preserve more geometric structure than BEV.
  % [GAP] Still processed representation. No phase information.
}

@article{hasan2024mmcasgan,
  title     = {mm-CasGAN: A cascaded adversarial neural framework for mmWave radar point cloud enhancement},
  author    = {Hasan, others},
  journal   = {Information Fusion},
  year      = {2024},
  url       = {https://www.sciencedirect.com/science/article/pii/S1566253524001660},
  % [TASK] Progressive radar point cloud refinement
  % [METHOD] Cascaded GAN stages, each targeting higher resolution. Hybrid loss
  %          (adversarial + geometric + consistency).
  % [INPUT] Processed point clouds
  % [KEY FINDING] Progressive multi-stage refinement outperforms single-shot approaches.
  % [GAP] Point cloud input, not raw radar.
}

% =============================================================================
% COMPLEX-VALUED / PHASE-AWARE RADAR PROCESSING
% =============================================================================

@inproceedings{fuchs2021cvnn,
  title     = {Complex-valued Convolutional Neural Networks for Enhanced Radar Signal Denoising and Interference Mitigation},
  author    = {Fuchs, Alexander and Rock, Johanna and Toth, Mate and Meissner, Paul and Pernkopf, Franz},
  booktitle = {IEEE Radar Conference},
  year      = {2021},
  url       = {https://arxiv.org/abs/2105.00929},
  % [TASK] Radar signal denoising and interference mitigation
  % [METHOD] True CVNN — all operations (conv, activation, norm) in complex domain
  % [INPUT] Complex-valued radar signals (I/Q)
  % [KEY FINDING] Phase preservation is "crucial for further processing, such as angle estimation."
  %              CVNNs show increased data efficiency, faster training, and substantially
  %              improved phase conservation vs real-valued networks.
  % [GAP] Denoising task, not point cloud generation. But the phase argument applies directly to us.
}

@inproceedings{hagele2025radarfusenet,
  title     = {RadarFuseNet: Complex-Valued Attention-Based Fusion of IQ Time- and Frequency-Domain Radar Features},
  author    = {Hagele, Misik and Steinbach, others},
  booktitle = {IEEE Radar Conference (RadarConf)},
  year      = {2025},
  url       = {https://arxiv.org/html/2512.11537v1},
  % [TASK] Occluded object classification from radar
  % [METHOD] Two complex-valued CNNs (one on raw IQ time-domain, one on FFT frequency-domain)
  %          fused via bidirectional cross-attention. All ops in complex domain.
  % [INPUT] Raw complex IQ + complex FFT output
  % [KEY FINDING] Processing "intact signal phasor" outperforms split representations.
  %              FFT alone provides richer features than raw IQ, but FUSING BOTH is best
  %              (91.99% -> 94.20%). All operations must stay complex to avoid info loss.
  % [GAP] Classification task, not point cloud generation. But the IQ+FFT fusion idea is
  %        directly applicable: we have both raw I/Q and FFT data available.
}

@inproceedings{gao2018cvcnn,
  title     = {Enhanced Radar Imaging Using a Complex-Valued Convolutional Neural Network},
  author    = {Gao, Jingkun and others},
  journal   = {arXiv preprint arXiv:1712.10096},
  year      = {2018},
  url       = {https://arxiv.org/abs/1712.10096},
  % [TASK] mm-wave radar imaging (SAR/ISAR context)
  % [METHOD] CV-CNN with two radar-specific modifications
  % [INPUT] Complex-valued radar data
  % [KEY FINDING] Superior imaging quality and computational efficiency vs real-valued CNN
  % [GAP] SAR/ISAR imaging, not FMCW point cloud generation. Different radar type.
}

